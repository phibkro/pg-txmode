{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/core": {
      "entry": ["scripts/readme.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/harness": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/lint": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/pg": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "tools/quality": {
      "entry": ["checkExceptions.ts"],
      "project": ["*.ts", "test/**/*.ts"]
    },
    "packages/effect": {
      "entry": [
        "test/**/*.test.ts",
        "test/m2bClient.ts",
        "test/finalizerClient.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignoreBinaries": ["gitleaks"],
  "ignoreDependencies": ["vite"]
}
