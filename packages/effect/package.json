{
  "name": "@pg-txmode/effect",
  "version": "0.1.0-alpha.3",
  "description": "Effect adapter of pg-txmode: a SqlClient and a transaction door for Effect on @effect/sql-pg, configured from the connection mode.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "prepublishOnly": "echo 'publish packages/effect/dist (bun run release:stage), not the source directory' && exit 1",
    "test": "bunx vp test",
    "build": "vp pack"
  },
  "dependencies": {
    "@pg-txmode/core": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@pg-txmode/harness": "workspace:*",
    "@pg-txmode/pg": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/sql-pg": ">=4.1.0 <4.2.0",
    "effect": ">=4.1.0 <4.2.0"
  }
}
